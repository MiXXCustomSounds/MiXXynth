{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure MiXXynth",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build-vs2026", "-G", "Visual Studio 18 2026", "-A", "x64"],
      "problemMatcher": []
    },
    {
      "label": "Build MiXXynth VST3",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build-vs2026", "--config", "Release", "--target", "MiXXynth_VST3"],
      "dependsOn": "Configure MiXXynth",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Validate MiXXynth VST3",
      "type": "shell",
      "command": "tools/pluginval/pluginval.exe",
      "args": ["--strictness-level", "5", "--verbose", "VST3/MiXXynth.vst3"],
      "dependsOn": "Build MiXXynth VST3",
      "problemMatcher": []
    },
    {
      "label": "Run MiXXynth patch audit",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build-vs2026", "--config", "Release", "--target", "MiXXynthPatchAudit"],
      "problemMatcher": ["$msCompile"]
    }
  ]
}
